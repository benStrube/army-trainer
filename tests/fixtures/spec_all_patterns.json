   "id": "s06",
   "title": "What field artillery brings",
   "chapter": "ch-1",
   "notes": {
    "talking_points": [],
    "extra_sources": []
   },
   "pattern": "key_idea",
   "statement": {
    "text": "Field artillery has two core competencies: coordinate fire support and deliver indirect fire.",
    "cite": [
     "para-1-27",
     "para-1-27.li1",
     "para-1-27.li2"
    ],
    "directive": null
   },
   "points": [
    {
     "text": "Indirect fire is fire delivered at a target the firing unit cannot see.",
     "cite": [
      "para-1-27.li2"
     ],
     "directive": null
    }
   ]
  },
