  {
   "id": "s15",
   "title": "Three fire support coordination measures",
   "chapter": "app-b",
   "notes": {
    "talking_points": [],
    "extra_sources": []
   },
   "pattern": "comparison",
   "columns": [
    {
     "heading": "Coordinated fire line",
     "points": [
      {
       "text": "Beyond it, surface fires may fire at any time without more coordination.",
       "cite": [
        "term-coordinated-fire-line"
       ],
       "directive": "may"
      }
     ]
    },
    {
     "heading": "No-fire area",
     "points": [
      {
       "text": "Fires or their effects are prohibited inside it.",
       "cite": [
        "term-no-fire-area"
       ],
       "directive": null
      }
     ]
    },
    {
     "heading": "Restrictive fire area",
     "points": [
      {
       "text": "Fires that exceed its limits will not be delivered without coordination.",
       "cite": [
        "para-B-36"
       ],
       "directive": "will not"
      }
     ]
    }
   ]
