  {
   "id": "s12",
   "title": "Sun observations: protect your eyes",
   "chapter": null,
   "notes": {
    "talking_points": [],
    "extra_sources": []
   },
   "pattern": "do_dont",
   "do": [
    {
     "text": "The sun filter should be inspected before use.",
     "cite": [
      "para-C-32.t2"
     ],
     "directive": "should"
    },
    {
     "text": "If the sun filter is damaged or lost, a solar observation may be completed by the card method.",
     "cite": [
      "para-C-32.t3"
     ],
     "directive": "may"
    }
   ],
   "dont": [
    {
     "text": "The sun must never be viewed through the telescope without a sun filter.",
     "cite": [
      "para-C-32.t2"
     ],
     "directive": "must"
    },
    {
     "text": "Don't skip the precautions: serious eye damage will result if proper precautions are not taken.",
     "cite": [
      "para-C-32.t3"
     ],
     "directive": null
    }
   ],
   "callout": "caution"
